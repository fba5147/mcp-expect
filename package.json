{
  "name": "mcp-expect",
  "version": "0.1.7",
  "description": "Jest-style assertions for testing MCP (Model Context Protocol) servers.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "mcp-expect": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/src/cli.js && cp -r example/fixtures dist/example/fixtures",
    "test": "npm run test:unit && npm run test:example",
    "test:unit": "npm run build && node --test dist/test/*.test.js",
    "test:example": "npm run build && node dist/src/cli.js \"dist/example/search.mcptest.js\"",
    "test:everything-server": "npm run build && node dist/src/cli.js \"dist/example/real-server.mcptest.js\"",
    "test:filesystem-server": "npm run build && node dist/src/cli.js \"dist/example/filesystem-server.mcptest.js\"",
    "test:http-server": "npm run build && node dist/src/cli.js \"dist/example/http-server.mcptest.js\"",
    "demo:fail": "npm run build && node dist/src/cli.js \"dist/example/red-demo.mcptest.js\"",
    "demo:security-fail": "npm run build && node dist/src/cli.js \"dist/example/security-red-demo.mcptest.js\"",
    "coverage": "npm run build && c8 --include \"dist/src/**\" --reporter=text --reporter=text-summary -- sh -c \"node --test dist/test/*.test.js && node dist/src/cli.js dist/example/search.mcptest.js dist/example/real-server.mcptest.js dist/example/filesystem-server.mcptest.js dist/example/http-server.mcptest.js\"",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fba5147/mcp-expect.git"
  },
  "homepage": "https://github.com/fba5147/mcp-expect#readme",
  "bugs": {
    "url": "https://github.com/fba5147/mcp-expect/issues"
  },
  "keywords": [
    "mcp",
    "expect",
    "model-context-protocol",
    "testing",
    "jest",
    "ci"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.20.0",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-everything": "^2026.7.4",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@types/node": "^22.5.0",
    "c8": "^12.0.0",
    "typescript": "^5.5.4",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
