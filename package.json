{
  "name": "mcp-testing-kit",
  "version": "0.1.0",
  "description": "Jest-style assertions for testing MCP (Model Context Protocol) servers.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "mcp-testing-kit": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:example": "npm run build && node dist/src/cli.js \"dist/example/*.mcptest.js\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "jest",
    "ci"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^22.5.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
